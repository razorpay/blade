{
  "name": "@razorpay/blade-svelte",
  "version": "0.20.0",
  "description": "Blade Design System for Svelte",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/*.module.css"
  ],
  "engines": {
    "node": ">=18.12.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "ssh://git@github.com/razorpay/blade.git"
  },
  "keywords": [
    "design system",
    "svelte",
    "razorpay",
    "blade"
  ],
  "exports": {
    ".": {
      "types": "./src-cx/index.ts",
      "svelte": "./src-cx/index.ts",
      "default": "./src-cx/index.ts"
    },
    "./runes": {
      "types": "./src-cx/runes/index.ts",
      "svelte": "./src-cx/runes/index.ts",
      "default": "./src-cx/runes/index.ts"
    },
    "./blade.css": "./src-cx/blade.css",
    "./fonts.css": "./src-cx/fonts.css",
    "./icons": {
      "types": "./src-cx/icons/index.d.ts",
      "default": "./src-cx/icons/index.js"
    },
    "./vite": {
      "types": "./src-cx/plugin/vite.d.ts",
      "default": "./src-cx/plugin/vite.js"
    },
    "./webpack": {
      "types": "./src-cx/plugin/webpack.d.ts",
      "default": "./src-cx/plugin/webpack.js"
    },
    "./uno.config": {
      "types": "./uno.config.ts",
      "default": "./uno.config.ts"
    },
    "./components": {
      "types": "./dist/types/components/index.d.ts",
      "svelte": "./dist/lib/components/index.js",
      "default": "./dist/lib/components/index.js"
    },
    "./utils": {
      "types": "./dist/types/utils/index.d.ts",
      "default": "./dist/lib/utils/index.js"
    },
    "./package.json": "./package.json"
  },
  "svelte": "./src-cx/index.ts",
  "files": [
    "dist",
    "!dist/**/__tests__",
    "src-cx",
    "!src-cx/test",
    "!src-cx/stories",
    "!src-cx/**/*.test.ts",
    "!src-cx/**/*.tmp.ts",
    "uno.config.ts",
    "uno"
  ],
  "scripts": {
    "prepare": "([ -d ../blade-core/dist ] || yarn --cwd ../blade-core build) && yarn build",
    "build": "npm-run-all build:clean build:generate-svelte-types build:generate-types build:lib",
    "build:clean": "rm -rf dist",
    "build:generate-types": "tsc -p ./tsconfig-generate-types.json",
    "build:generate-svelte-types": "node ./scripts/generate-svelte-component-types.mjs",
    "build:lib": "rollup -c",
    "svelte-check": "svelte-check --tsconfig ./tsconfig.json && svelte-check --tsconfig ./tsconfig.cx.json",
    "svelte-check:watch": "svelte-check --tsconfig ./tsconfig.cx.json --watch",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "dev": "npm-run-all --parallel dev:blade-core storybook",
    "dev:blade-core": "cd ../blade-core && yarn build:watch",
    "start:web": "yarn dev",
    "prestorybook": "cd ../blade-core && yarn build",
    "storybook": "storybook dev -p 6008 -c .storybook-cx --host 0.0.0.0",
    "build-storybook": "storybook build -c .storybook-cx -o storybook-static",
    "test:browserstack": "playwright test -c tests/browserstack/playwright.config.cts",
    "test:browserstack:local": "CHROMATIC_URL=https://blade.razorpay.com playwright test -c tests/browserstack/playwright.config.cts",
    "test:browserstack:mobile": "browserstack-node-sdk playwright test --config tests/browserstack/playwright.mobile.config.cts",
    "test:browserstack:mobile:local": "CHROMATIC_URL=https://blade.razorpay.com browserstack-node-sdk playwright test --config tests/browserstack/playwright.mobile.config.cts",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.ts",
    "test:e2e:ui": "playwright test -c tests/e2e/playwright.config.ts --ui",
    "test:e2e:browserstack": "TARGET=browserstack BROWSERSTACK_CONFIG_FILE=tests/e2e/browserstack.yml browserstack-node-sdk playwright test -c tests/e2e/playwright.config.ts"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.6.0",
    "@razorpay/blade-core": ">=0.21.0",
    "@razorpay/i18nify-js": "1.12.8",
    "@use-gesture/vanilla": "10.2.24",
    "class-variance-authority": "^0.7.0",
    "svg-pathdata": "^7.2.0",
    "svg2ttf": "^6.1.0",
    "svgicons2svgfont": "^15.0.1",
    "wawoff2": "^2.0.1"
  },
  "devDependencies": {
    "@babel/core": "7.21.8",
    "@babel/preset-typescript": "7.16.5",
    "@playwright/test": "^1.52.0",
    "@rollup/plugin-alias": "5.0.0",
    "@rollup/plugin-babel": "6.0.3",
    "@rollup/plugin-commonjs": "25.0.4",
    "@rollup/plugin-node-resolve": "15.2.1",
    "@storybook/addon-docs": "10.2.16",
    "@storybook/addon-links": "10.2.16",
    "@storybook/addon-svelte-csf": "^5.0.10",
    "@storybook/svelte-vite": "10.2.16",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@testing-library/jest-dom": "^6",
    "@testing-library/svelte": "5.4.2",
    "@testing-library/user-event": "^14",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "3.2.6",
    "browserstack-node-sdk": "1.60.1",
    "dotenv": "^16.4.5",
    "jsdom": "^25",
    "magic-string": "^0.30.5",
    "npm-run-all": "4.1.5",
    "postcss": "^8.4.0",
    "rollup": "3.30.0",
    "rollup-plugin-peer-deps-external": "2.2.4",
    "rollup-plugin-postcss": "4.0.2",
    "rollup-plugin-svelte": "^7.2.2",
    "storybook": "10.2.16",
    "sveld": "^0.36.1",
    "svelte": "5.56.10",
    "svelte-check": "^4.0.0",
    "svelte-preprocess": "^6.0.3",
    "typescript": "^5.0.0",
    "unocss": "^66.10.5",
    "vite": "^5.0.0",
    "vitest": "3.2.6"
  },
  "peerDependencies": {
    "svelte": ">=5.56.10",
    "unocss": ">=66.0.0"
  },
  "peerDependenciesMeta": {
    "unocss": {
      "optional": true
    }
  }
}
