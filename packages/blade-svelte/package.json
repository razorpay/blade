{
  "name": "@razorpay/blade-svelte",
  "version": "1.0.1",
  "description": "Blade Design System for Svelte",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/*.module.css"
  ],
  "engines": {
    "node": ">=18.12.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "ssh://git@github.com/razorpay/blade.git"
  },
  "keywords": [
    "design system",
    "svelte",
    "razorpay",
    "blade"
  ],
  "exports": {
    "./blade.css": "./src/blade.css",
    "./icons": {
      "types": "./src/icons/index.d.ts",
      "default": "./src/icons/index.js"
    },
    "./configs/vite": {
      "types": "./src/plugin/vite.d.ts",
      "default": "./src/plugin/vite.js"
    },
    "./configs/webpack": {
      "types": "./src/plugin/webpack.d.ts",
      "default": "./src/plugin/webpack.js"
    },
    "./configs/uno": {
      "types": "./uno/config.ts",
      "default": "./uno/config.js"
    },
    "./configs/lint": {
      "types": "./src/lint/plugin.d.ts",
      "default": "./src/lint/plugin.js"
    },
    "./components": {
      "types": "./src/components-entry.ts",
      "svelte": "./src/components-entry.ts",
      "default": "./src/components-entry.ts"
    },
    "./runes": {
      "types": "./src/runes/index.ts",
      "svelte": "./src/runes/index.ts",
      "default": "./src/runes/index.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "!src/test",
    "!src/stories",
    "!src/**/*.test.ts",
    "!src/**/*.tmp.ts",
    "uno"
  ],
  "scripts": {
    "svelte-check": "svelte-check --tsconfig ./tsconfig.json",
    "svelte-check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "check:tree-shaking": "node ./scripts/check-tree-shaking.mjs",
    "build:uno-config": "node ./scripts/build-uno-config.mjs",
    "icons:generate": "node ./scripts/icon-svgs/extract-blade.mjs",
    "icons:check": "node ./scripts/icon-svgs/extract-blade.mjs --check",
    "dev": "yarn storybook",
    "start:web": "yarn dev",
    "storybook": "storybook dev -p 6008 -c .storybook --host 0.0.0.0",
    "build-storybook": "storybook build -c .storybook -o storybook-static",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.ts",
    "test:e2e:ui": "playwright test -c tests/e2e/playwright.config.ts --ui",
    "test:e2e:browserstack": "TARGET=browserstack BROWSERSTACK_CONFIG_FILE=tests/e2e/browserstack.yml browserstack-node-sdk playwright test -c tests/e2e/playwright.config.ts"
  },
  "dependencies": {
    "@razorpay/blade-core": ">=0.21.0",
    "svg-pathdata": "^7.2.0",
    "svg2ttf": "^6.1.0",
    "svgicons2svgfont": "^15.0.1",
    "wawoff2": "^2.0.1"
  },
  "devDependencies": {
    "@babel/core": "7.21.8",
    "@babel/preset-typescript": "7.16.5",
    "@playwright/test": "^1.52.0",
    "@razorpay/i18nify-js": "1.12.8",
    "@storybook/addon-docs": "10.2.16",
    "@storybook/addon-links": "10.2.16",
    "@storybook/addon-svelte-csf": "^5.0.10",
    "@storybook/svelte-vite": "10.2.16",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@testing-library/jest-dom": "^6",
    "@testing-library/svelte": "5.4.2",
    "@testing-library/user-event": "^14",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "3.2.6",
    "browserstack-node-sdk": "1.60.1",
    "dotenv": "^16.4.5",
    "esbuild": "0.27.2",
    "jsdom": "^25",
    "magic-string": "^0.30.5",
    "npm-run-all": "4.1.5",
    "storybook": "10.2.16",
    "svelte": "5.56.10",
    "svelte-check": "^4.0.0",
    "typescript": "^5.0.0",
    "unocss": "^66.10.5",
    "vite": "^6.4.3",
    "vitest": "3.2.6"
  },
  "peerDependencies": {
    "@razorpay/i18nify-js": ">=1.12.8",
    "svelte": ">=5.56.10",
    "unocss": ">=66.0.0",
    "vite": ">=8.0.0"
  },
  "peerDependenciesMeta": {
    "unocss": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  }
}
